{
  "name": "ai-usage-island",
  "productName": "AI Usage Island",
  "version": "2.2.0",
  "description": "맥 화면 위 가운데에서 Claude, ChatGPT, Gemini 계정별 사용 한도를 보여주는 앱",
  "main": "electron/main.cjs",
  "author": "hyunho2378",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "@number-flow/react": "^0.6.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.4"
  },
  "build": {
    "appId": "io.github.hyunho2378.aiusageisland",
    "productName": "AI Usage Island",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "AI Usage Island"
    },
    "artifactName": "AI-Usage-Island-${version}-${arch}.${ext}"
  }
}
